{
  "datasets": [
    {
      "name": "ds_kpis",
      "displayName": "KPIs del día",
      "queryLines": [
        "WITH t AS (\n",
        "  SELECT event_date, COUNT(*) AS buques_activos, SUM(n_posiciones) AS posiciones,\n",
        "         ROUND(SUM(distancia_km), 0) AS distancia_total_km\n",
        "  FROM oceanwatch_g07.gold.trayectorias_diarias_buque GROUP BY event_date),\n",
        "p AS (\n",
        "  SELECT event_date, COUNT(*) AS puertos_con_actividad, SUM(buques_en_puerto_al_cierre) AS buques_en_puerto_al_cierre\n",
        "  FROM oceanwatch_g07.gold.puertos_resumen_diario GROUP BY event_date),\n",
        "a AS (\n",
        "  SELECT event_date, COUNT_IF(es_anomalia) AS anomalias\n",
        "  FROM oceanwatch_g07.gold.anomalias_velocidad_diarias GROUP BY event_date)\n",
        "SELECT t.event_date, t.buques_activos, t.posiciones, t.distancia_total_km,\n",
        "       COALESCE(p.puertos_con_actividad, 0) AS puertos_con_actividad,\n",
        "       COALESCE(p.buques_en_puerto_al_cierre, 0) AS buques_en_puerto_al_cierre,\n",
        "       COALESCE(a.anomalias, 0) AS anomalias\n",
        "FROM t LEFT JOIN p USING (event_date) LEFT JOIN a USING (event_date)\n",
        "ORDER BY t.event_date\n"
      ]
    },
    {
      "name": "ds_mapa",
      "displayName": "Intensidad por celda H3",
      "queryLines": [
        "SELECT event_date, h3_r8, centro_lat, centro_lon,\n",
        "       SUM(posiciones)        AS posiciones,\n",
        "       MAX(buques_distintos)  AS buques_hora_pico,\n",
        "       ROUND(LOG10(SUM(posiciones)), 3) AS intensidad_log10\n",
        "FROM oceanwatch_g07.gold.trafico_celda_hora\n",
        "GROUP BY event_date, h3_r8, centro_lat, centro_lon\n"
      ]
    },
    {
      "name": "ds_hora",
      "displayName": "Tráfico por hora",
      "queryLines": [
        "SELECT event_date, hora,\n",
        "       SUM(posiciones) AS posiciones,\n",
        "       SUM(buques_carga) AS carga, SUM(buques_tanquero) AS tanquero, SUM(buques_pasajeros) AS pasajeros,\n",
        "       SUM(buques_pesca) AS pesca, SUM(buques_remolque) AS remolque, SUM(buques_recreo) AS recreo\n",
        "FROM oceanwatch_g07.gold.trafico_celda_hora\n",
        "GROUP BY event_date, hora\n",
        "ORDER BY event_date, hora\n"
      ]
    },
    {
      "name": "ds_puertos",
      "displayName": "Ranking de puertos",
      "queryLines": [
        "SELECT event_date, ranking, port_name, buques_distintos, arribos, buques_atracados,\n",
        "       buques_en_puerto_al_cierre, ROUND(duracion_media_horas, 2) AS duracion_media_horas,\n",
        "       buques_carga, buques_tanquero, buques_pasajeros, port_lat, port_lon\n",
        "FROM oceanwatch_g07.gold.puertos_resumen_diario\n",
        "WHERE ranking <= 20\n",
        "ORDER BY event_date, ranking\n"
      ]
    },
    {
      "name": "ds_en_puerto",
      "displayName": "Buques en puerto",
      "queryLines": [
        "SELECT event_date, port_name, mmsi, COALESCE(vessel_name, '(sin nombre)') AS vessel_name, vessel_type_group,\n",
        "       arribo_ts, salida_ts, duracion_horas, estado, en_puerto_al_cierre\n",
        "FROM oceanwatch_g07.gold.estadias_puerto\n",
        "WHERE en_puerto_al_cierre OR estado = 'ATRACADO_O_FONDEADO'\n",
        "ORDER BY event_date, port_name, duracion_horas DESC\n"
      ]
    },
    {
      "name": "ds_anomalias",
      "displayName": "Anomalías del día",
      "queryLines": [
        "SELECT event_date, mmsi, COALESCE(vessel_name, '(sin nombre)') AS vessel_name, vessel_type_group,\n",
        "       ROUND(anomaly_score, 4) AS anomaly_score, motivo_principal,\n",
        "       sog_max_kn, velocidad_implicita_max_kn, ROUND(distancia_km, 1) AS distancia_km, n_posiciones,\n",
        "       lat_ultima, lon_ultima, modelo_version\n",
        "FROM oceanwatch_g07.gold.anomalias_velocidad_diarias\n",
        "WHERE es_anomalia\n",
        "ORDER BY event_date, anomaly_score DESC\n"
      ]
    }
  ],
